# NEAR AI Cloud (https://cloud.near.ai) — never commit real keys
NEARAI_API_KEY=
NEARAI_BASE_URL=https://cloud-api.near.ai/v1
NEARAI_MODEL=Qwen/Qwen3.6-35B-A3B-FP8

# NEAR testnet
NEAR_NETWORK=testnet
BAZAAR_CONTRACT_ID=
SERVER_ACCOUNT_ID=
SERVER_PRIVATE_KEY=

# Canal Street agents (contract v3). Locally the keys come from ~/.near-credentials, written by
# `pnpm --filter @bazaar/merchant setup:agents`. Hosted: a JSON map of account → private key.
# AGENT_KEYS=
