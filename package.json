{
  "name": "bazaar-of-liars",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.2.2",
  "scripts": {
    "test": "pnpm -r test",
    "haggle": "pnpm --filter @bazaar/core haggle",
    "sim": "pnpm --filter @bazaar/core sim",
    "check:nearai": "node --env-file=.env scripts/check-nearai.mjs",
    "verify:model": "pnpm --filter @bazaar/verify verify:model",
    "haggle:llm": "pnpm --filter @bazaar/merchant haggle:llm",
    "verify:haggle": "pnpm --filter @bazaar/merchant verify:haggle",
    "test:contract": "cargo test --manifest-path contracts/bazaar/Cargo.toml",
    "dev": "pnpm --parallel --filter @bazaar/server --filter @bazaar/web dev",
    "build": "pnpm --filter @bazaar/web build",
    "start": "pnpm --filter @bazaar/server start"
  }
}
