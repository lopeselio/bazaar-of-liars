{
  "name": "bazaar-of-liars",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.2.2",
  "scripts": {
    "test": "pnpm -r test",
    "haggle": "pnpm --filter @bazaar/core haggle",
    "sim": "pnpm --filter @bazaar/core sim",
    "check:nearai": "node --env-file-if-exists=.env scripts/check-nearai.mjs",
    "verify:model": "pnpm --filter @bazaar/verify verify:model",
    "verify:deed": "pnpm --filter @bazaar/verify verify:deed",
    "haggle:llm": "pnpm --filter @bazaar/merchant haggle:llm",
    "verify:haggle": "pnpm --filter @bazaar/merchant verify:haggle",
    "test:contract": "cargo test --manifest-path contracts/bazaar/Cargo.toml",
    "dev": "pnpm --parallel --filter @bazaar/server --filter @bazaar/web --filter @bazaar/city dev",
    "build": "pnpm --filter @bazaar/web --filter @bazaar/city build",
    "start": "pnpm --filter @bazaar/server start",
    "check:goods": "node --env-file-if-exists=.env scripts/check-goods.mjs",
    "typecheck": "pnpm -r exec tsc --noEmit -p ."
  }
}
