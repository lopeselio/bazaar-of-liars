{
  "name": "@bazaar/merchant",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./bundle": "./src/bundle.ts"
  },
  "scripts": {
    "test": "vitest run",
    "haggle:llm": "node --env-file-if-exists=../../.env --import tsx src/cli/haggle-llm.ts",
    "verify:haggle": "node --env-file-if-exists=../../.env --import tsx src/cli/verify-haggle.ts",
    "setup:agents": "node --env-file=../../.env --import tsx src/cli/setup-agents.ts",
    "rekey:agents": "node --env-file=../../.env --import tsx src/cli/rekey-agents.ts"
  },
  "dependencies": {
    "@bazaar/core": "workspace:*",
    "@bazaar/verify": "workspace:*",
    "near-kit": "0.20.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "ethers": "^6.17.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
